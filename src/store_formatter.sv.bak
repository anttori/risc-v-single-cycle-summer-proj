module store_formatter(
	input logic [31:0] data,
	
	input logic [2:0] func3,
	
	input logic [1:0] addr,
	
	input logic MemRW,
	
	output logic [31:0] dmem_wdata,
	
	output logic [3:0] dmem_data_en
);

always_comb begin
	
	case(func3) 
		// Default values
		dmem_wdata = data;
		dmem_data_en = 4'b0000;
		
		// SW - Store word
		3'b010: begin
		
			dmem_wdata = data;
			dmem_data_en = (MemRW) ? 4'b1111 : 4'b0000;
		end
		
		
		// SH - Store half
		3'b001: begin
			
			dmem_wdata = (addr[1]) { 16'b0, data[31:16] }  ?  { 16'b0, data[15:0] };
			
			dmem_data_en = (addr[1]) 4'b1100 ? 4'b0011;
		end
		
		
		// SB - Store byte
		3'b000: begin
			
			case(addr)
					
				2'b00: begin
					dmem_wdata = { 24'b0, data[7:0] };
					dmem_data_en = 4'b0001;
				end
				
				2'b01: begin
					dmem_wdata = { 16'b0, data[7:0], 8'b0 };
					dmem_data_en = 4'b0010;
				end
				
				2'b10: begin
					dmem_wdata = { 8'b0, data[7:0], 16'b0 };
					dmem_data_en = 4'b0100;
				end
				
				2'b11: begin
					dmem_wdata = { data[7:0], 24'b0 };
					dmem_data_en = 4'b1000;
				end
			
			endcase
		end
	endcase
end

endmodule