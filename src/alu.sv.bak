import riscv_pkg::*;

module alu (

	input logic [31:0] reg1,		// input Reg 1
	input logic [31:0] reg2,		// input Reg 2
	
	input logic ALUCtrl,			// ALU state flag
	
	
	output logic alu_out			// ALU result output
);

	always_comb begin

		case(ALUCtrl)
		
			SUB: alu_out = reg1 - reg2;		// Substract
			
			default: alu_out = reg1 + reg2;		// Add
		
		endcase

	end
	
endmodule