module load_extender(
	input logic [31:0] dmem_data,		// Raw 4-byte data word from DMEM 
	
	input logic [1:0] addr,		// Byte number inside received 4-byte word (dmem_data)
	
	input logic [2:0] func3,	
	
	output logic [31:0] data_wb
);


always_comb begin
	
	case(func3) begin
		
		// LB
		3'b000: begin
			case(addr)
			
				// First byte
				2'b00: data_wb = { {24{dmem_data[7]}}, dmem_data[7:0] };
				
				// Second byte
				2'b01: data_wb = { {24{dmem_data[15]}}, dmem_data[15:8] };
				
				// Third byte
				2'b10: data_wb = { {24{dmem_data[23]}}, dmem_data[23:16] };
				
				// Fourth byte
				2'b11: data_wb = { {24{dmem_data[31]}}, dmem_data[31:24] };
				
			endcase
		end
		
		// LH
		3'b001: begin
			case(addr)
			
				// First half
				2'b00: data_wb = { {16{dmem_data[15]}}, dmem_data[15:0] };
				
				// Last half
				2'b01: data_wb = { {16{dmem_data[31]}}, dmem_data[31:16] };
				
			endcase
		end
		
		// LW
		3'b010: data_wb = dmem_data;
			
		// LBU
		3'b100: begin
			case(addr)
			
				// First byte
				2'b00: data_wb = { 24'b0, dmem_data[7:0] };
				
				// Second byte
				2'b01: data_wb = { 24'b0, dmem_data[15:8] };
				
				// Third byte
				2'b10: data_wb = { 24'b0, dmem_data[23:16] };
				
				// Fourth byte
				2'b11: data_wb = { 24'b0, dmem_data[31:24] };
				
			endcase
		end
		
		// LHU
		3'b001: begin
			case(addr)
			
				// First half
				2'b00: data_wb = { 16'b0, dmem_data[15:0] };
				
				// Last half
				2'b01: data_wb = { 16'b0, dmem_data[31:16] };
				
			endcase
		end
	
	endcase

end


endmodule